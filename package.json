{
  "name": "astroiq",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "cf-typegen": "wrangler types",
    "deploy:staging": "opennextjs-cloudflare build && wrangler deploy --env staging",
    "deploy:production": "opennextjs-cloudflare build && wrangler deploy --env production",
    "upload:production": "opennextjs-cloudflare build && wrangler versions upload --env production"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.6.5",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "stripe": "^18.5.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.3",
    "typescript": "^5.9.2",
    "wrangler": "^4.38.0"
  },
  "type": "module"
}
